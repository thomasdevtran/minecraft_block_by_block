# Copy to .env.local and fill in your Supabase project's values (Project Settings → API).
# Both are browser-facing; access is enforced by the database's row-level policies.
# Leave them empty to run the site without accounts, My Builds or Community.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional: VITE_OFFLINE=off builds the offline kill switch (see README, Offline guides).
